node_modules/
dist/

# 运行时状态：会话（含 cookie）、曲库、日志、临时产物。
# 这些永远不该进仓库，尤其是公开仓库。
.data/
*.log
astra.db
astra.db-shm
astra.db-wal
*-session.json
# Steam 凭据（Web API key + SteamID64）。不是 *-session.json，单独列，
# 漏了这条一个 git add . 就把 key 推上公开仓库了。
steam-credentials.json
login-pending.json
bili-login-pending.json
login-qr.png
bili-login-qr.png

# 音源脚本由用户自己导入，不进仓库
# 音源脚本（洛雪 .js）：名字五花八门，用目录排除更可靠
lx-sources/
qdy*.js
*source*.js

# 临时文件
*.part-*
*.tagging
*.v-*.tmp
*.a-*.tmp
*.out-*.tmp*

# 路径拼错留下的目录（反斜杠丢了，Windows 绝对路径被当成单段目录名）。
# 不删：另一个会话的代理测试可能还在用；但绝不能进仓库。
*AppDataLocalTemp*/

# 本机生成的命令树可视化产物（不是仓库内容）
astra-命令树*.html
astra-命令树*.svg
astra-命令树*.png
scripts/gen-tree.mjs
