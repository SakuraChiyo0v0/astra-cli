# 复制到 <部署根>/hermes/data/.env（Hermes 自己读的密钥文件），权限 600。不要提交。

# ---- 模型：同机 WorkBuddy2API（OpenAI 兼容）----
OPENAI_BASE_URL=http://workbuddy2api:7863/v1
OPENAI_API_KEY=<WorkBuddy2API config.json 里的 api_key>

# ---- 飞书 ----
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=<App Secret>
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
# 只允许这些人和机器人说话（open_id，ou_ 开头）。留空 = 谁都能用，务必填
FEISHU_ALLOWED_USERS=ou_xxx
# 定时任务 / 通知发到哪个会话（可在飞书里对机器人发 /set-home 设置）
# FEISHU_HOME_CHANNEL=oc_xxx
