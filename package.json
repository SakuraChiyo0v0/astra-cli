{
  "name": "astra-cli",
  "version": "0.48.0",
  "private": true,
  "description": "\u7ed9 AI \u8c03\u7528\u7684\u4e2a\u4eba\u80fd\u529b CLI\uff1a\u4e00\u6761\u547d\u4ee4\u529e\u5b8c\u4e00\u4ef6\u4e8b\uff0c\u8f93\u51fa\u7edf\u4e00 JSON",
  "type": "module",
  "bin": {
    "astra": "./dist/astra.mjs"
  },
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "astra": "node --disable-warning=ExperimentalWarning src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "tree": "node scripts/gen-tree.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "lzma": "^2.3.2",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "steam-session": "^1.8.0",
    "steam-user": "^5.3.0"
  }
}
